CREATE TABLE review_state (
    pack_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    facet INTEGER NOT NULL,
    state INTEGER NOT NULL,
    ease INTEGER NOT NULL,
    interval_days INTEGER NOT NULL,
    due_at INTEGER NOT NULL,
    reps INTEGER NOT NULL,
    lapses INTEGER NOT NULL,
    last_reviewed_at INTEGER NOT NULL,
    PRIMARY KEY (pack_id, item_id, facet)
);

CREATE INDEX review_state_pack ON review_state(pack_id, state, due_at);

CREATE TABLE review_log (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    ts INTEGER NOT NULL,
    day INTEGER NOT NULL,
    pack_id TEXT NOT NULL,
    item_id TEXT NOT NULL,
    facet INTEGER NOT NULL,
    exercise INTEGER NOT NULL,
    grade INTEGER NOT NULL,
    correct INTEGER NOT NULL,
    practice INTEGER NOT NULL
);

CREATE INDEX review_log_day ON review_log(day);
CREATE INDEX review_log_pack ON review_log(pack_id, ts);

upsertState:
INSERT OR REPLACE INTO review_state (
    pack_id, item_id, facet, state, ease, interval_days, due_at, reps, lapses, last_reviewed_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertStateIfMissing:
INSERT OR IGNORE INTO review_state (
    pack_id, item_id, facet, state, ease, interval_days, due_at, reps, lapses, last_reviewed_at
) VALUES (?, ?, ?, 0, 2500, 0, 0, 0, 0, 0);

selectState:
SELECT * FROM review_state WHERE pack_id = ? AND item_id = ? AND facet = ?;

selectStates:
SELECT * FROM review_state WHERE pack_id = ?;

selectStateKeys:
SELECT item_id, facet FROM review_state WHERE pack_id = ?;

deleteItemStates:
DELETE FROM review_state WHERE pack_id = ? AND item_id = ?;

deleteFacetState:
DELETE FROM review_state WHERE pack_id = ? AND item_id = ? AND facet = ?;

deletePackStates:
DELETE FROM review_state WHERE pack_id = ?;

resetPackStates:
UPDATE review_state
SET state = 0, ease = 2500, interval_days = 0, due_at = 0, reps = 0, lapses = 0, last_reviewed_at = 0
WHERE pack_id = ?;

packCounts:
SELECT
    pack_id,
    COUNT(*) AS total,
    COALESCE(SUM(CASE WHEN state = 0 THEN 1 ELSE 0 END), 0) AS new_count,
    COALESCE(SUM(CASE WHEN state = 1 THEN 1 ELSE 0 END), 0) AS learning_count,
    COALESCE(SUM(CASE WHEN state = 2 AND interval_days >= :masteredDays THEN 1 ELSE 0 END), 0) AS mastered_count,
    COALESCE(SUM(CASE WHEN (state = 1 AND due_at <= :learnCutoff) OR (state = 2 AND due_at < :reviewCutoff) THEN 1 ELSE 0 END), 0) AS due_count
FROM review_state
GROUP BY pack_id;

sectionCounts:
SELECT
    i.section_id AS section_id,
    COUNT(*) AS total,
    COALESCE(SUM(CASE WHEN s.state = 0 THEN 1 ELSE 0 END), 0) AS new_count,
    COALESCE(SUM(CASE WHEN s.state = 1 THEN 1 ELSE 0 END), 0) AS learning_count,
    COALESCE(SUM(CASE WHEN s.state = 2 AND s.interval_days >= :masteredDays THEN 1 ELSE 0 END), 0) AS mastered_count,
    COALESCE(SUM(CASE WHEN (s.state = 1 AND s.due_at <= :learnCutoff) OR (s.state = 2 AND s.due_at < :reviewCutoff) THEN 1 ELSE 0 END), 0) AS due_count
FROM review_state AS s
JOIN item AS i ON i.pack_id = s.pack_id AND i.item_id = s.item_id
WHERE s.pack_id = :packId
GROUP BY i.section_id;

overallCounts:
SELECT
    COALESCE(SUM(CASE WHEN state != 0 THEN 1 ELSE 0 END), 0) AS learned_count,
    COALESCE(SUM(CASE WHEN state = 2 AND interval_days >= :masteredDays THEN 1 ELSE 0 END), 0) AS mastered_count,
    COALESCE(SUM(CASE WHEN (state = 1 AND due_at <= :learnCutoff) OR (state = 2 AND due_at < :reviewCutoff) THEN 1 ELSE 0 END), 0) AS due_count
FROM review_state;

insertLog:
INSERT INTO review_log (ts, day, pack_id, item_id, facet, exercise, grade, correct, practice) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastStudied:
SELECT pack_id, MAX(ts) AS last_ts FROM review_log GROUP BY pack_id;

logByDay:
SELECT day, COUNT(*) AS reviews, COALESCE(SUM(CASE WHEN correct THEN 1 ELSE 0 END), 0) AS correct_count
FROM review_log
GROUP BY day
ORDER BY day;
